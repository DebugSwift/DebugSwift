load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
load("@build_bazel_rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")

swift_interop_hint(
    name = "signal_capture_module",
    module_map = "DebugSwiftSignalCapture/module.modulemap",
    module_name = "DebugSwiftSignalCapture",
)

objc_library(
    name = "exception_capture",
    srcs = ["DebugSwiftSignalCapture/ExceptionCapture.m"],
    hdrs = ["DebugSwiftSignalCapture/include/DebugSwiftExceptionCapture.h"],
    includes = ["DebugSwiftSignalCapture/include"],
    sdk_frameworks = ["Foundation"],
    # Export its C ABI through the single signal_capture_module map, not a
    # second inferred module that would claim the same public header.
    aspect_hints = ["@build_bazel_rules_swift//swift:no_module"],
)

cc_library(
    name = "DebugSwiftSignalCapture",
    srcs = glob(["DebugSwiftSignalCapture/*.c"]) + ["DebugSwiftSignalCapture/SignalCaptureInternal.h"],
    hdrs = glob(["DebugSwiftSignalCapture/include/*.h"]),
    includes = ["DebugSwiftSignalCapture/include"],
    copts = ["-std=c11"],
    linkopts = ["-framework", "Foundation"],
    aspect_hints = [":signal_capture_module"],
    deps = [":exception_capture"],
)

swift_library(
    name = "DebugSwift",
    srcs = glob(["DebugSwift/Sources/**/*.swift"]),
    data = glob(["DebugSwift/Resources/**"]),
    module_name = "DebugSwift",
    deps = [":DebugSwiftSignalCapture"],
    visibility = ["//visibility:public"],
)
